# Environment variables for the churn prediction platform.
# Copy to .env and adjust — docker compose reads .env automatically.

# --- webui (Gradio demo UI, port 7860) -------------------------------------
# URL of the inference API as seen from the webui container.
INFERENCE_URL=http://inference:8002

# --- inference (port 8002) --------------------------------------------------
# URL of the preprocessing service as seen from the inference container.
PREPROCESSING_URL=http://preprocessing:8001
# URL of the monitoring service as seen from the inference container.
MONITORING_URL=http://monitoring:8003
# Churn score at or above which an offer is recommended.
CHURN_THRESHOLD=0.5
# Gunicorn workers per service (memory-hungry: each loads the models).
WORKERS=2
# Directory containing the .pkl model artifacts inside the containers.
MODELS_DIR=models

# --- webui data -------------------------------------------------------------
# Path to the dataset CSV used to pre-fill the form with a random profile.
DATA_PATH=data/churn.csv
